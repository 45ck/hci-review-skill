{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact component agent contract index",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "/agent-index.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "$ref": "./agent-contracts.schema.json#/properties/package"
    },
    "sdk": {
      "$ref": "./agent-contracts.schema.json#/properties/sdk"
    },
    "release": {
      "$ref": "./agent-contract.schema.json#/$defs/release"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "./agent-contracts.schema.json#/properties/entries/items/properties/id"
          },
          "kind": {
            "$ref": "./agent-contracts.schema.json#/properties/entries/items/properties/kind"
          },
          "purpose": {
            "$ref": "./agent-contracts.schema.json#/properties/entries/items/properties/purpose"
          },
          "exports": {
            "$ref": "./agent-contracts.schema.json#/properties/entries/items/properties/exports"
          },
          "contract": {
            "type": "string",
            "pattern": "^/contracts/[a-z0-9-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "actionSchema": {
            "type": "string",
            "pattern": "^/agent-action-inputs\\.json#/\\$defs/[a-z0-9-]+$"
          }
        },
        "required": [
          "id",
          "kind",
          "purpose",
          "exports",
          "contract",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "package",
    "sdk",
    "release",
    "entries"
  ],
  "additionalProperties": false
}
