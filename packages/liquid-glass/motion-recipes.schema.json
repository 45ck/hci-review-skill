{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/motion-recipes.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "policy",
    "recipes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "type": "object"
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "intent",
          "targets",
          "component",
          "implementation",
          "trigger",
          "durationMs",
          "interruption",
          "reducedMotion",
          "useWhen",
          "avoidWhen",
          "requires",
          "completionMeaning",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "state",
              "feedback",
              "continuity",
              "presence",
              "progress",
              "attention"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "component": {
            "type": "string"
          },
          "implementation": {
            "enum": [
              "native",
              "existing-sdk",
              "host-adapter"
            ]
          },
          "trigger": {
            "type": "string"
          },
          "durationMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 1200
          },
          "interruption": {
            "enum": [
              "retarget",
              "cancel"
            ]
          },
          "reducedMotion": {
            "const": "instant-final-state"
          },
          "useWhen": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "avoidWhen": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "completionMeaning": {
            "const": "presentation-only"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
