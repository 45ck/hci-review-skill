    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "@webgpu/types": "0.1.66",
    "html2canvas-pro": "2.6.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "ai": "^7.0.179",
    "@ag-ui/core": "^1.0.5",
    "openai": "^7.62.0",
    "@anthropic-ai/sdk": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@ag-ui/core": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "tools",
    "docs",
    "LICENSES",
    "assets",
    "*.json",
    "README.md",
    "AGENTS.md",
    "src/**/*.md"
  ],
  "bin": {
    "quantive-agent-documents": "./tools/agent-documents-cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node ../../scripts/build-liquid-glass.mjs",
    "prepack": "node ../../scripts/build-liquid-glass.mjs"
  }
}
